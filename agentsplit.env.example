# The settings of the server on the NixOS host: /etc/agentsplit/agentsplit.env
# ("Secrets on the host" in DEPLOYMENT.md). Never commit real values.
# nix/module.nix sets DATABASE_URL, HOST, PORT and DATABASE_POOL_SIZE; a value
# in this file overrides them.

# The public origin. OAuth issuers, cookies and upload targets are built from it.
BASE_URL=https://agentsplit.example.com

# Must be the production secret: it decrypts the imported JWT signing key and
# signs the session cookies (docs/history/v2/DESIGN.md). At least 32 characters.
BETTER_AUTH_SECRET=replace-with-current-value
# Google-only sign-in (Google Auth Platform: Web application client).
# Redirect: https://YOUR_APP_HOST/api/auth/callback/google
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
# Verified Google email that may claim the groups created before accounts existed.
AUTH_BOOTSTRAP_EMAIL=

# The receipts bucket ("Receipts on R2" in DEPLOYMENT.md).
S3_UPLOAD_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
S3_UPLOAD_REGION=auto
S3_UPLOAD_BUCKET=agentsplit-receipts
# An R2 API token with Object Read and Write on this bucket only.
S3_UPLOAD_KEY=replace-with-access-key-id
S3_UPLOAD_SECRET=replace-with-secret-access-key
# redirect: after the access check, send readers to a presigned storage URL.
# Empty means stream: the server sends the bytes, for storage that browsers cannot reach.
RECEIPT_DOWNLOADS=redirect

# The maintenance switch (DEPLOYMENT.md). Set to 1 to answer 503 to everything
# but the health checks (/api/health, /api/health/readiness, /api/health/liveness); unset to open.
AGENTSPLIT_MAINTENANCE=

# Fair-use cap on new accounts per 24 hours. Empty means 200; existing accounts always sign in.
SIGN_UP_DAILY_LIMIT=
