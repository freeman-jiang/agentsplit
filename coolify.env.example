# Set these in the Coolify resource environment; never commit real credentials.
BASE_URL=https://agentsplit.example.com
STORAGE_HOST=receipts.example.com
# Generate each 64-character secret separately with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-random-hex
GARAGE_RPC_SECRET=replace-with-random-hex
S3_UPLOAD_SECRET=replace-with-random-hex
# Access key: GK followed by 32 random hex characters (openssl rand -hex 16)
S3_UPLOAD_KEY=GKreplace-with-random-hex
