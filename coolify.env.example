# Set these in the Coolify resource environment; never commit real credentials.
BASE_URL=https://agentsplit.example.com
STORAGE_HOST=receipts.example.com
# Generate each 64-character secret separately with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-random-hex
GARAGE_RPC_SECRET=replace-with-random-hex
S3_UPLOAD_SECRET=replace-with-random-hex
# Access key: GK followed by 32 random hex characters (openssl rand -hex 16)
S3_UPLOAD_KEY=GKreplace-with-random-hex
# Set only when enabling MCP; see MCP.md. Keep this in Coolify, not Git.
MCP_ACCESS_GRANTS=

# Google-only sign-in (Google Auth Platform: Web application client).
# Redirect: https://YOUR_APP_HOST/api/auth/callback/google
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
BETTER_AUTH_SECRET=replace-with-separate-random-64-character-secret
# Verified Google email to claim groups existing before the auth cutover.
AUTH_BOOTSTRAP_EMAIL=
# Required only if legacy MCP_ACCESS_GRANTS has more than one user.
AUTH_BOOTSTRAP_LEGACY_USER_ID=
BETTER_AUTH_TELEMETRY=0
