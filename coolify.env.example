# The environment of compose.coolify.yaml (AgentSplit). Set these in the
# Coolify resource environment; never commit real values. DEPLOYMENT.md
# describes each one.

# The public origin. OAuth issuers, cookies and upload targets are built from it.
BASE_URL=https://agentsplit.example.com

# The database (db2, PostgreSQL 18). Generate it with: openssl rand -hex 32
DB2_PASSWORD=replace-with-random-hex
# The old app's database (db). v2 does not use it; keep the production value
# so that db stays readable for a rollback.
POSTGRES_PASSWORD=replace-with-current-value

# Must be the production secret: it decrypts the imported JWT signing key and
# signs the session cookies (docs/history/v2/DESIGN.md).
BETTER_AUTH_SECRET=replace-with-current-value
# Google-only sign-in (Google Auth Platform: Web application client).
# Redirect: https://YOUR_APP_HOST/api/auth/callback/google
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
# Verified Google email that may claim the groups created before accounts existed.
AUTH_BOOTSTRAP_EMAIL=

# Garage: the production values, which the old app also used for the same receipts.
GARAGE_RPC_SECRET=replace-with-current-value
S3_UPLOAD_KEY=GKreplace-with-current-value
S3_UPLOAD_SECRET=replace-with-current-value

# Not read by v2; the old app's compose file needs them, so keep them for a rollback:
# STORAGE_HOST, MCP_ACCESS_GRANTS, AUTH_BOOTSTRAP_LEGACY_USER_ID, BETTER_AUTH_TELEMETRY.

# The maintenance switch (DEPLOYMENT.md). Set to 1 to answer 503 to everything
# but the health checks (/api/health, /api/health/readiness, /api/health/liveness); unset to open.
AGENTSPLIT_MAINTENANCE=

# Fair-use cap on new accounts per 24 hours. Empty means 200; existing accounts always sign in.
SIGN_UP_DAILY_LIMIT=
