POSTGRES_PRISMA_URL=postgresql://postgres:1234@localhost
POSTGRES_URL_NON_POOLING=postgresql://postgres:1234@localhost

# Public URL this instance is reachable at. Defaults to http://localhost:3000.
# BASE_URL=http://localhost:3000

# Default currency pre-selected when creating a new group. Defaults to USD.
# DEFAULT_CURRENCY_CODE=EUR

# AgentSplit privacy profile. Analytics and built-in AI are disabled in code.
NEXT_TELEMETRY_DISABLED=1
CHECKPOINT_DISABLE=1
ANALYTICS_PROVIDER=
ENABLE_EXPENSE_DOCUMENTS=false
ENABLE_RECEIPT_EXTRACT=false
ENABLE_CATEGORY_EXTRACT=false
NEXT_PUBLIC_ENABLE_EXPENSE_DOCUMENTS=false
NEXT_PUBLIC_ENABLE_RECEIPT_EXTRACT=false
NEXT_PUBLIC_ENABLE_CATEGORY_EXTRACT=false

# For attachments, configure storage and set ENABLE_EXPENSE_DOCUMENTS=true.
# The Coolify stack supplies these settings automatically (see DEPLOYMENT.md).
# S3_UPLOAD_ENDPOINT=https://receipts.example.com
# S3_UPLOAD_BUCKET=agentsplit-receipts
# S3_UPLOAD_REGION=garage
# S3_UPLOAD_KEY=
# S3_UPLOAD_SECRET=
# Leave OpenAI credentials unset. See PRIVACY.md.
