# The environment of compose.v2.coolify.yaml (AgentSplit v2). Set these in the
# Coolify resource environment; never commit real values. The names follow
# coolify.env.example, so the current values carry over unchanged.

# The public origin. OAuth issuers, cookies and upload targets are built from it.
BASE_URL=https://agentsplit.example.com

# v2's database (db2, PostgreSQL 18). New; generate it with: openssl rand -hex 32
DB2_PASSWORD=replace-with-random-hex
# The current app's database (db). v2 does not use it; keep the current value
# so that db stays readable for the import and for a rollback.
POSTGRES_PASSWORD=replace-with-current-value

# Must be the production secret: it decrypts the imported JWT signing key and
# signs the session cookies (docs/v2/DESIGN.md).
BETTER_AUTH_SECRET=replace-with-current-value
# Google-only sign-in (Google Auth Platform: Web application client).
# Redirect: https://YOUR_APP_HOST/api/auth/callback/google
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
# Verified Google email that may claim the groups created before accounts existed.
AUTH_BOOTSTRAP_EMAIL=

# Garage: the same values as the current app, so v2 reads the existing receipts.
GARAGE_RPC_SECRET=replace-with-current-value
S3_UPLOAD_KEY=GKreplace-with-current-value
S3_UPLOAD_SECRET=replace-with-current-value

# Not read by v2; the current app's compose file needs them, so keep them for a rollback:
# STORAGE_HOST, MCP_ACCESS_GRANTS, AUTH_BOOTSTRAP_LEGACY_USER_ID, BETTER_AUTH_TELEMETRY.

# The cutover freeze. Set to 1 to answer 503 to everything but /api/health; unset to open.
AGENTSPLIT_MAINTENANCE=
